# 복사해서 쓴다: cp .env.example .env  (.env 는 git 에 올리지 않는다)
# 변수 설명: docs/dev/local-setup.md §4

# --- PostgreSQL (infra/compose.yaml) ---
DB_PORT=15432
DB_NAME=meetmiddle
DB_USER=meetmiddle
DB_PASSWORD=change-me-local

# --- Redis ---
REDIS_PORT=16379

# --- 백엔드 ---
BACKEND_PORT=18080
# 32바이트 이상 랜덤. 예: openssl rand -base64 48
JWT_SECRET=

# --- 프론트 ---
FRONTEND_PORT=15173

# --- 외부 API (비워 두면 local 프로필에서 Fake 사용) ---
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
ODSAY_API_KEY=
TMAP_APP_KEY=
