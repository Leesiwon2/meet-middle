#!/usr/bin/env bash
# 커밋 메시지 규약 검사. 정본: docs/CONVENTION.md §1
# 배선(클론마다 1회): git config core.hooksPath .githooks
set -euo pipefail
export LC_ALL=C.UTF-8

msg_file="$1"
comment_char="$(git config --get core.commentChar || echo '#')"

types='feat|fix|docs|test|refactor|perf|style|build|ci|chore|revert'
scopes='be|fe|db|infra|ci|room|participant|recommend|place|auth'

# 주석·빈 줄을 건너뛴 첫 줄 = 제목
subject="$(grep -v "^${comment_char}" "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"
subject="${subject%$'\r'}"

fail() {
  {
    echo "✗ 커밋 메시지 규약 위반: $1"
    echo "  제목: ${subject:-<비어 있음>}"
    echo "  형식: type(scope): 제목   예) feat(room): 방 생성 API 추가"
    echo "  type : ${types//|/ }"
    echo "  scope: ${scopes//|/ } (선택, 여러 개면 쉼표)"
    echo "  정본 : docs/CONVENTION.md §1"
  } >&2
  exit 1
}

[[ -n "$subject" ]] || fail "제목이 비어 있다"

# git 이 만드는 메시지는 통과 (merge, revert, fixup/squash/amend)
if [[ "$subject" =~ ^(Merge\ |Revert\ \"|fixup!\ |squash!\ |amend!\ ) ]]; then
  exit 0
fi

re="^(${types})(\(([a-z,]+)\))?!?: ([^[:space:]].*)$"
[[ "$subject" =~ $re ]] || fail "형식이 'type(scope): 제목' 이 아니다 (type 은 영문 소문자, 콜론 뒤 공백 한 칸)"

scope_list="${BASH_REMATCH[3]}"
title="${BASH_REMATCH[4]}"

if [[ -n "$scope_list" ]]; then
  IFS=',' read -ra parts <<< "$scope_list"
  for s in "${parts[@]}"; do
    [[ "$s" =~ ^(${scopes})$ ]] || fail "알 수 없는 scope '$s'"
  done
fi

(( ${#subject} <= 72 )) || fail "제목이 72자를 넘는다 (${#subject}자)"
[[ "$title" != *. ]] || fail "제목 끝에 마침표를 쓰지 않는다"

exit 0
